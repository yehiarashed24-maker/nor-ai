GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_MODEL=gemini-3.6-flash
# Quick spoken visual answers use this first; the model above stays as fallback.
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
PORT=8787
# Hosted Arabic Whisper service. Leave blank only if Gemini fallback is intended.
WHISPER_API_URL=http://localhost:8000
# Must match WHISPER_API_TOKEN on the ASR service when it is internet-facing.
WHISPER_API_TOKEN=replace_with_a_long_random_secret
